# Copie para .env e personalize (o arquivo .env nunca deve ir para o GitHub)
PORT=4000
NODE_ENV=development
# Obrigatório para voto durável no Render. Ex.: PostgreSQL do Neon.
DATABASE_URL=
# Segredo longo e aleatório para gerar o identificador não reversível do eleitor.
VOTE_SECRET=substitua-por-uma-string-longa-aleatoria
# Opcional: senha compartilhada com o time para proteger a votação.
VOTE_ACCESS_CODE=
# Opcional: habilita fotos REAIS do Google Places via API oficial (pode gerar custo).
GOOGLE_MAPS_API_KEY=
# Se usar PostgreSQL com SSL desabilitado em rede local, definir PG_SSL=false.
PG_SSL=true

# Somente organizador: habilita o painel para abrir/encerrar o segundo turno.
VOTE_ADMIN_KEY=
